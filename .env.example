# Opcional. Token do GitHub (sem nenhuma permissao) para aumentar o limite da API
# de 60 para 5.000 requisicoes por hora. Crie em: https://github.com/settings/tokens
GITHUB_TOKEN=

# Obrigatorio para o formulario de contato. Chave do Resend com permissao "Sending access".
# Crie em: https://resend.com/api-keys
# Sem dominio verificado, o Resend so entrega para o e-mail da propria conta, que precisa
# ser o mesmo de siteConfig.email (lib/site.ts).
RESEND_API_KEY=
